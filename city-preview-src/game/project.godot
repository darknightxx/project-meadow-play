config_version=5
[application]
config/name="Meadowfall — City Preview"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
[display]
window/dpi/allow_hidpi=false
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.73, 0.81, 0.82, 1)
textures/vram_compression/import_etc2_astc=false
textures/vram_compression/import_s3tc_bptc=false
textures/default_filters/anisotropic_filtering_level=2
